\import{holbert-macros}
\title{Proofs!}
\taxon{Theorem}
\p{All [even](evens) numbers are natural numbers.}
\hol/proof{evensarenats}{
  \hol/dep{config}{config}
  \hol/dep{nats}{nat} 
  \hol/dep{evens}{evens} 
}{  
  x.
    (Even x)
    ---------------- f
    (Nat x)
  
  x. asm |- ?
}  
\hol/proof{natinversion}{
  \hol/dep{config}{config}
  \hol/dep{nats}{nat} 
}{  
  x.
    (Nat (@S x))
    ---------------- S-inv
    (Nat x)
  
  x. asm |- ?
}  
