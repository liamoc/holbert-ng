\title{Logical Connectives}
\taxon{Definition}
\import{holbert-macros}
\hol/notation{logicsymbols}{
  \hol/dep{config}{config}
}{
  infixl or _||_
  infixl and _&&_
  infixr implies _->_
  tighter not than and
  tighter and than or
  tighter or than implies
}
\hol/axioms{proplogic}{
  \hol/dep{config}{config}
  \hol/local{logicsymbols}
}{
  A.B.
    A
    B
    ---- AndI
    (A && B)
  A.B.
    (A && B)
    ---------- AndE1
    A
  A.B.
    (A && B)
    ---------- AndE2
    B
  A.B.
    A
    ---- OrI1
    (A || B)
  A.B.
    B
    ---- OrI2
    (A || B)
  A.B.C.
    (A || B)
    [ A |- C]
    [ B |- C]
    --------- OrE
    C

    ---- TrueI
    top
  X.
    bot
    ---- FalseE
    X
  A.
    [X. A |- X]
    ----------- NotI
    (not A)
  A.X.
    (not A)
    A
    -------- NotE
    X
  A.B.
    [ A |- B]
    --------- ImpI
    (A -> B)
  A.B.
    (A -> B)
    A
    ------------ ImpE
    B
  P.
    [a. (P a)]
    ---------- AllI
    (all (x. P x))
  P.x.
    (all (a. P a))
    ------------------ AllE
    (P x)
  P.x.
    (P x)
    ----- ExI
    (exists (a. P a))
  P.C.
    (exists (a. P a))
    [x. (P x) |- C]
    ------------------ ExE
    C
}

\hol/proof{test}{\hol/local{proplogic} \hol/dep{config}{config}   \hol/local{logicsymbols}}{
  P.
  
  ------------------- Test
  ((exists (x. not (P x))) -> (not (all (x. P x))))

 P. |- ?
}
